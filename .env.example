# Free key from https://etherscan.io/apidashboard — enables the sender-history
# checks (address-poisoning signature, "paid before"). Without it those checks
# are skipped and the page says so.
ETHERSCAN_API_KEY=

# Optional. A private Sepolia RPC URL (Alchemy, Infura, ...). If empty, public
# Sepolia endpoints are used.
SEPOLIA_RPC_URL=
